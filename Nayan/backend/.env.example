# ==========================================
# Nayan Backend Environment Variables (.env)
# ==========================================

# --- Supabase Database Configuration ---
# If omitted or invalid, the backend automatically uses local JSON fallbacks in data/cameras.json and data/alerts.json
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# --- Twilio SMS & Voice Dispatches ---
# Required for sending automated SMS and Voice alerts during SOS triggers
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890
VOICEMAIL_URL_HIGH=https://handler.twilio.com/twiml/your_high_priority_twiml
VOICEMAIL_URL_MED=https://handler.twilio.com/twiml/your_med_priority_twiml
VOICEMAIL_URL_LOW=https://handler.twilio.com/twiml/your_low_priority_twiml

# --- Roboflow Configuration (Optional Override) ---
# Used for real-time gender classification
ROBOFLOW_API_KEY=0Hh1bvT2yb5UXrNloKWV
ROBOFLOW_PROJECT=gender-bkoji
ROBOFLOW_VERSION=1
